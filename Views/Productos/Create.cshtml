@model CatalogoProductos.Models.Producto

<h2>Registrar Producto</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Categoría</label>
        <input asp-for="Categoria" class="form-control" />
        <span asp-validation-for="Categoria"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Precio</label>
        <input asp-for="Precio"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Stock</label>
        <input asp-for="Stock"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fecha</label>
        <input asp-for="FechaRegistro"
               type="date"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Guardar Producto
    </button>

</form>
